---
interface Props {
  base?: string;
}

const { base = '/sovereigntyatlas' } = Astro.props;
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<footer class="mt-20 border-t border-border bg-card/50 text-foreground transition-colors">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-4">
      {/* Brand & Manifesto */}
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="flex size-7 items-center justify-center rounded-lg bg-primary/10 text-primary border border-primary/20">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
              <path d="M2 12h20" />
            </svg>
          </div>
          <span class="text-base font-extrabold tracking-tight">
            Sovereignty<span class="text-primary">Atlas</span>
          </span>
          <span class="rounded bg-primary/10 px-1.5 py-0.5 text-[10px] font-bold text-primary">
            MIT
          </span>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed max-w-md">
          Sovereignty Atlas is an open-source, community-driven geopolitical independence metric created by 
          <a href="https://github.com/BanguDevClub" target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline">BanguDevClub</a>.
          Evaluating all 195 universally recognized nations across Consumption, Employment, Technological, Scientific, and Military self-reliance.
        </p>
        <div class="flex items-center gap-3 pt-2 text-xs text-muted-foreground">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 px-2 py-0.5 text-[10px] font-semibold">
            <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            2025 Edition
          </span>
          <span>195 Sovereign States</span>
          <span>&bull;</span>
          <span>5 Pillars Weighted</span>
        </div>
      </div>

      {/* Navigation */}
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
          Pages & Tools
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href={`${cleanBase}/`} class="text-muted-foreground hover:text-primary transition-colors">Overview</a></li>
          <li><a href={`${cleanBase}/dashboard`} class="text-muted-foreground hover:text-primary transition-colors">Country Dashboard</a></li>
          <li><a href={`${cleanBase}/continents`} class="text-muted-foreground hover:text-primary transition-colors">Continents & Regions</a></li>
          <li><a href={`${cleanBase}/ranking`} class="text-muted-foreground hover:text-primary transition-colors">Global 195 Ranking</a></li>
          <li><a href={`${cleanBase}/compare`} class="text-muted-foreground hover:text-primary transition-colors">Head-to-Head Compare</a></li>
          <li><a href={`${cleanBase}/sandbox`} class="text-muted-foreground hover:text-primary transition-colors">Interactive Sandbox</a></li>
          <li><a href={`${cleanBase}/methodology`} class="text-muted-foreground hover:text-primary transition-colors">Scientific Methodology</a></li>
        </ul>
      </div>

      {/* Methodology Weights */}
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-3">
          Methodology Ranking
        </h4>
        <ul class="space-y-1.5 text-xs text-muted-foreground">
          <li class="flex items-center justify-between">
            <span>1. Consumption</span>
            <span class="font-semibold text-foreground">28%</span>
          </li>
          <li class="flex items-center justify-between">
            <span>2. Employment</span>
            <span class="font-semibold text-foreground">25%</span>
          </li>
          <li class="flex items-center justify-between">
            <span>3. Technological</span>
            <span class="font-semibold text-foreground">20%</span>
          </li>
          <li class="flex items-center justify-between">
            <span>4. Scientific</span>
            <span class="font-semibold text-foreground">15%</span>
          </li>
          <li class="flex items-center justify-between">
            <span>5. Military</span>
            <span class="font-semibold text-foreground">12%</span>
          </li>
          <li class="pt-2 border-t border-border flex items-center justify-between font-bold text-foreground">
            <span>Total Index</span>
            <span class="text-primary">100%</span>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Copyright */}
    <div class="mt-10 border-t border-border pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted-foreground">
      <p>
        &copy; 2025 <a href="https://github.com/BanguDevClub/sovereigntyatlas" target="_blank" rel="noopener noreferrer" class="hover:text-primary font-medium">BanguDevClub</a>. Released under the MIT Open Source License.
      </p>
      <div class="flex items-center gap-4">
        <a href="https://github.com/BanguDevClub/sovereigntyatlas" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors flex items-center gap-1.5">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          github.com/BanguDevClub/sovereigntyatlas
        </a>
      </div>
    </div>
  </div>
</footer>
