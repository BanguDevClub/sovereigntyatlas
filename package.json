{
  "name": "sovereigntyatlas",
  "type": "module",
  "version": "1.0.0",
  "description": "Sovereignty Atlas - Open-source metric dashboards, ranking, and compare tool evaluating the national independence of 195 countries.",
  "author": "BanguDevClub",
  "license": "MIT",
  "homepage": "https://github.com/BanguDevClub/sovereigntyatlas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BanguDevClub/sovereigntyatlas.git"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,css}\" README.md",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,css}\" README.md",
    "typecheck": "astro check && tsc --noEmit",
    "typecheck:astro": "astro check",
    "typecheck:ts": "tsc --noEmit",
    "data:validate": "python3 scripts/validate_dataset.py",
    "data:generate": "python3 scripts/build_atlas_dataset.py",
    "fix": "npm run format && npm run lint:fix",
    "clean": "rm -rf dist .astro",
    "clean:all": "rm -rf dist .astro node_modules package-lock.json",
    "reinstall": "npm run clean:all && npm install",
    "validate": "npm run data:validate && npm run typecheck && npm run lint && npm run format:check && npm run build",
    "check:all": "npm run validate",
    "help": "node scripts/qol_menu.js"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
